# Copy to .env.local and fill in. Never commit .env.local.
# .env.local is gitignored; so is a stray "env.local" without the dot.

# Resend API key - sends the contact form to CONTACT_TO_EMAIL
RESEND_API_KEY=

# Where contact-form messages are delivered
CONTACT_TO_EMAIL=

# Cloudflare Turnstile - secret key, verified server-side only
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile - site key, safe to expose in the browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
