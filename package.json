{
  "name": "portfolio",
  "version": "0.1.0",
  "private": "true",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "test": "playwright test",
    "globe:dots": "tsx scripts/generate-globe-dots.ts",
    "test:prod": "playwright test --config=playwright.prod.config.ts",
    "certificates": "tsx scripts/process-certificates.ts",
    "build:prod": "BUILD_DIR=.next-prod next build",
    "start:prod": "BUILD_DIR=.next-prod next start -p 3700",
    "i18n:check": "tsx scripts/i18n-check.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "resend": "^6.33.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "world-atlas": "^2.0.2"
  }
}
