#!/usr/bin/env bash
# Block commits that contain secrets. Requires gitleaks on PATH.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH - install it or commit with --no-verify at your own risk." >&2
  exit 1
fi

gitleaks git --staged --redact --no-banner .
